        48,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const TARGETS = ['elkandelk.com', 'nphm.com', 'slaterzurz.com', 'plevinandgallucci.com', 'misnylaw.com', 'corboydemetrio.com', 'salvilaw.com', 'cliffordlaw.com', 'rblaw.net'];\n\nfunction djb2(str) {\n  let h = 5381;\n  for (let i = 0; i < str.length; i++) h = (((h << 5) + h) ^ str.charCodeAt(i)) >>> 0;\n  return h.toString(16);\n}\n\nconst lastMonth = new Date(Date.now() - 30 * 86400000).toISOString();\nconst out = [];\n\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (!TARGETS.some(t => String(r.watch_url).includes(t))) continue;\n\n  const sents = String(r.content_text || '').split(/(?<=[.!?])\\s+/).filter(s => s.trim().length > 0);\n  if (sents.length < 6) continue;\n\n  // Keep every other sentence so the removed ones are spread across the whole\n  // page, not just the boilerplate tail. Those become 'new' on the next run.\n  const keep = sents.filter((s, i) => i % 2 === 0);\n  const trimmed = keep.join(' ');\n\n  out.push({ json: {\n    watch_url: r.watch_url,\n    content_hash: djb2(trimmed),\n    content_text: trimmed,\n    last_checked: lastMonth,\n    last_changed: lastMonth,\n    removed_sentences: sents.length - keep.length\n  } });\n}\n\nreturn out;"
      },
